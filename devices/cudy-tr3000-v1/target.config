# Cudy TR3000 v1 设备配置 (精简版 - 仅保留核心驱动与 Nikki)
# 目标: mediatek/filogic (MT7981BA + 256MB DDR3 + 128MB SPI-NAND)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-v1=y

# 硬件特有驱动与固件 (2.5G WAN Airoha EN8811H PHY 与板载 I2C RTC)
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-rtc-pcf8563=y

# 网络与基础工具 (Nikki 运行与订阅更新必需)
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_yq=y

# Nikki 代理套件与 Mihomo 核心
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y
