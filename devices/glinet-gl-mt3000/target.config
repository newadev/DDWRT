# GL.iNet GL-MT3000 (Beryl AX) 设备配置 (精简版 - 仅保留核心驱动与 Nikki)
# 目标: mediatek/filogic (MT7981BA + 512MB DDR3 + 256MB SPI-NAND, 原生 UBI 布局)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3000=y

# 硬件特有驱动 (主动散热温控风扇与 USB 3.0 支持)
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-usb3=y

# 网络与基础工具 (Nikki 运行与订阅更新必需)
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_yq=y

# Nikki 代理套件与 Mihomo 核心
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y
