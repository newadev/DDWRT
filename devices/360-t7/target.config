# 360T7 (Qihoo 360T7) 全 UBI 布局设备配置 (精简版 - 仅保留核心驱动与 Nikki)
# 目标: mediatek/filogic (MT7981B + 512MB DDR4 + 128MB SPI-NAND, 全 UBI 固件)
# 需配套全 UBI U-Boot / preloader 引导
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7 is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7-ubi=y

# 网络与基础工具 (Nikki 运行与订阅更新必需)
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_yq=y

# Nikki 代理套件与 Mihomo 核心
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y
